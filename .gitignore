# dependencies
node_modules/
.pnpm-store/

# build outputs
dist/
build/
out/

# C++ workers (CMake)
apps/workers/**/build/
cmake-build-*/
compile_commands.json
# worker-manager output (pnpm workers:manager)
worker-results/*
!worker-results/.gitkeep

# Prisma Client is generated on install (postinstall); api-client's src/generated IS committed
apps/backend/src/generated/

# turbo
.turbo/

# env
.env
.env.*
!.env.example

# vulnerability database downloads (apps/backend VULN_CACHE_DIR, doubles as an offline mirror)
apps/backend/.cache/

# logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# misc
coverage/
*.tsbuildinfo

# claude — local-only settings; shared agents/commands may be committed
.claude/settings.local.json
.claude/.cc-writes/

# Claude Code worktrees
.claude/worktrees/
