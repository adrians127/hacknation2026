{
  "name": "hacknation2026",
  "version": "0.0.0",
  "private": true,
  "description": "Attack Surface Intelligence \u2014 discovery scan du\u017cej infrastruktury (HackNation 2026, CBI AGH)",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "project:setup": "node scripts/setup-env.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "generate": "turbo run generate",
    "clean": "turbo run clean",
    "infra:up": "docker compose -f docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f docker/docker-compose.yml down",
    "infra:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "db:up": "docker compose -f docker/docker-compose.yml up -d postgres",
    "db:logs": "docker compose -f docker/docker-compose.yml logs -f postgres",
    "db:reset": "pnpm --filter @hacknation/backend db:reset",
    "workers:build": "docker compose -f docker/docker-compose.workers.yml build masscan-worker",
    "workers:masscan": "docker compose -f docker/docker-compose.workers.yml run --rm -T masscan-worker"
  },
  "devDependencies": {
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "turbo": "^2.11.13"
  }
}
