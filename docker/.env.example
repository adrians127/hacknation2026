# docker/.env for the app in Docker (docker-compose.yml, profile `app`). Copy it, then
# replace every secret (production mode refuses example values):
#   JWT_SECRET            openssl rand -hex 32
#   DATA_ENCRYPTION_KEY   openssl rand -base64 32   (never change it once data exists)
#   WORKER_TOKEN          openssl rand -hex 32      (worker-manager reads it from here too)
JWT_SECRET=
DATA_ENCRYPTION_KEY=
WORKER_TOKEN=
ADMIN_EMAIL=admin@hacknation.local
ADMIN_PASSWORD=

# Where browsers open the app; must match how you reach it (CORS).
PUBLIC_URL=http://localhost:3000
# 127.0.0.1 = this machine only; 0.0.0.0 = other machines too (set PUBLIC_URL to match).
APP_BIND=127.0.0.1
APP_PORT=3000
