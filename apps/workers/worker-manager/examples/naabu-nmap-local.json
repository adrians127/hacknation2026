{
  "schema_version": 1,
  "jobs": [
    {
      "job_id": "naabu-local",
      "worker": "naabu",
      "split": { "strategy": "none" },
      "params": {
        "targets": ["127.0.0.1"],
        "ports": [80, 443],
        "rate": 100,
        "scan_type": "connect",
        "max_duration_seconds": 30
      }
    },
    {
      "job_id": "nmap-local",
      "worker": "nmap",
      "split": { "strategy": "none" },
      "params": {
        "targets": ["127.0.0.1"],
        "ports": [80, 443],
        "rate": 50,
        "max_duration_seconds": 60,
        "host_timeout_ms": 15000
      }
    }
  ]
}
