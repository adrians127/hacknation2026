/// One upload of a scan's services to DefectDojo (modules/defectdojo). The `testId` of the
/// latest successful push is the test later pushes reimport into.
model DefectDojoPush {
  id          String               @id @default(uuid(7)) @db.Uuid
  scanId      String               @db.Uuid
  scope       DefectDojoPushScope
  status      DefectDojoSyncStatus @default(running)
  startedAt   DateTime             @default(now())
  finishedAt  DateTime?
  startedById String?              @db.Uuid
  findings    Int                  @default(0)
  testId      Int?
  /// DefectDojoPushStatsSchema (contracts); null while running and when it failed.
  stats       Json?
  error       String?

  scan      Scan  @relation(fields: [scanId], references: [id], onDelete: Cascade)
  startedBy User? @relation(fields: [startedById], references: [id], onDelete: SetNull)

  @@index([scanId])
  @@index([startedById])
  @@index([startedAt])
}

enum DefectDojoPushScope {
  scan
  selection
}
