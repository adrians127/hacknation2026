/// One entry of the target inventory: an IPv4 address, a CIDR (at most /16) or a domain.
model Target {
  id          String     @id @default(uuid(7)) @db.Uuid
  kind        TargetKind
  /// Normalized by the shared parser (@subsurf/contracts/targets/target-input): the dedup key.
  value       String     @unique
  /// { "$enc": "v1.…" } (src/lib/crypto.ts); null = no note.
  note        Json?
  tags        String[]   @default([])
  /// The addresses an `ip` or `cidr` covers, as unsigned integers: address order in the list and
  /// "which target holds this address". Null for a domain.
  rangeStart  BigInt?
  rangeEnd    BigInt?
  createdById String     @db.Uuid
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdBy User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  scans     ScanTarget[]

  @@index([createdById])
  @@index([rangeStart])
}

enum TargetKind {
  ip
  cidr
  domain
}
