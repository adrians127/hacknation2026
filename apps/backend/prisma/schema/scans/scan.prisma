/// One scan run. Its addresses are split into ScanJob batches that workers lease.
model Scan {
  id            String     @id @default(uuid(7)) @db.Uuid
  status        ScanStatus @default(queued)
  /// Shown in lists; an imported scan gets its file's name.
  name          String     @default("")
  /// { "$enc": "v1.…" } (src/lib/crypto.ts); null = no note.
  note          Json?
  origin        ScanOrigin @default(adhoc)
  /// SHA-256 of an imported file's content: the same file is imported once.
  importKey     String?    @unique
  /// Parameters snapshotted from the backend's defaults when the scan was queued.
  ports         String
  maxRate       Int
  batchSize     Int
  targetCount   Int
  addressCount  Int
  jobCount      Int
  /// ImportWarning[] from @subsurf/contracts (domains that could not be scanned).
  warnings      Json       @default("[]")
  requestedById String     @db.Uuid
  createdAt     DateTime   @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  updatedAt     DateTime   @updatedAt

  requestedBy User              @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  targets     ScanTarget[]
  jobs        ScanJob[]
  results     ScanJobResult[]
  defectDojoPushes DefectDojoPush[]
  hosts       HostObservation[]

  @@index([requestedById])
  @@index([status, createdAt])
}

/// How a scan came to be: started from the target import form, from a scan configuration by
/// hand or on its schedule, or read from a results file.
enum ScanOrigin {
  adhoc
  manual
  scheduled
  imported
}

enum ScanStatus {
  queued
  running
  completed
  stopped
  failed
}
