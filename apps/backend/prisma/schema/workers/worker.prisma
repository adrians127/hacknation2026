/// A block pipelines are built from: one worker worker-manager can run, under the same `name`
/// (WORKER_MANAGER_WORKERS). Registered by a manager's lease request; its capabilities come from
/// the worker's manifest the manager announces (`worker_specs`).
model Worker {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String   @unique
  /// Admin-owned from registration on; seeded from the manifest.
  displayName     String
  description     String   @default("")
  /// WorkerInput[]: `targets` and/or `hosts`. From the manifest, replaced on every lease request.
  inputs          String[] @default(["targets"])
  /// SplitStrategy[] worker-manager may use on its jobs. From the manifest.
  splitStrategies String[] @default(["none"])
  /// WorkerParamField[] from @subsurf/contracts. From the manifest.
  paramFields     Json     @default("[]")
  /// Packets per second a step of this worker may use at most. Admin-owned; seeded from the manifest.
  maxRate         Int      @default(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  steps PipelineStep[]
}
