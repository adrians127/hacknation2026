/// A set of permissions. The four system roles (key set) are synced from code at startup and are read-only.
model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// admin | editor | analyst | viewer for system roles, null for custom roles.
  key         String?  @unique
  name        String   @unique
  description String   @default("")
  isSystem    Boolean  @default(false)
  /// `resource:action` keys from @hacknation/contracts/auth/permissions.
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}
