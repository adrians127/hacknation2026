/// One worker run's result for one lease of a ScanJob: the `scan` object of
/// docs/worker-result-format.md. Written by results ingest, never edited.
model ScanJobResult {
  id            String              @id @default(uuid(7)) @db.Uuid
  scanId        String              @db.Uuid
  scanJobId     String              @db.Uuid
  leaseId       String
  /// worker-manager splits a leased job into tasks, one worker run and one result each.
  taskIndex     Int                 @default(1)
  taskCount     Int                 @default(1)
  workerId      String
  workerVersion String
  nmapVersion   String?
  status        ScanJobResultStatus
  stopReason    ScanStopReason?
  startedAt     DateTime
  finishedAt    DateTime
  durationMs    Int
  /// { hostDiscovery, portScan, serviceDetection, http } in milliseconds.
  phasesMs      Json
  /// What the worker actually ran, nmapArgs included: kept for the scan-safety audit.
  params        Json
  counts        Json
  /// { code, message } when the job itself failed.
  error         Json?
  receivedAt    DateTime            @default(now())

  scan    Scan              @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanJob ScanJob           @relation(fields: [scanJobId], references: [id], onDelete: Cascade)
  hosts   HostObservation[]

  /// Workers resend a result when the response is lost: a second copy is ignored.
  @@unique([leaseId, taskIndex])
  @@index([scanId])
  @@index([scanJobId])
}

enum ScanJobResultStatus {
  completed
  partial
  failed
}

enum ScanStopReason {
  deadline
  stop_requested
  lease_lost
  error
}
