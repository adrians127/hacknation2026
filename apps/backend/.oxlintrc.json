{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "node", "vitest"],
  "env": {
    "node": true
  },
  "rules": {
    "no-underscore-dangle": ["warn", { "allow": ["_count"] }]
  },
  "ignorePatterns": ["dist/**", "logs/**", "src/generated/**"]
}
