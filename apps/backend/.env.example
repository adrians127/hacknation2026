# development | production | test. `development` enables pretty logs, Swagger UI
# at /docs and stack traces in error responses — local laptops only.
NODE_ENV=development

# HTTP port. 3001 keeps clear of the frontend dev server (3000).
PORT=3001

# pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Single allowed browser origin (cookies are sent with credentials, so no `*`).
CORS_ORIGIN=http://localhost:3000

# PostgreSQL as discrete parts (no DATABASE_URL; see src/config/database-url.ts).
# Defaults match docker/docker-compose.yml (`pnpm db:up`).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hacknation
DB_USER=hacknation
DB_PASSWORD=hacknation
# disable | allow | prefer | require | verify-ca | verify-full (default: require).
# The local container serves plaintext, so `disable` here.
DB_SSLMODE=disable

# HS256 key for the 15-minute access JWT, at least 32 characters. Production
# refuses to start with this example value: generate one, e.g. `openssl rand -base64 48`.
JWT_SECRET=dev-only-jwt-secret-change-me-in-production
