# development | production | test. `development` enables pretty logs, Swagger UI
# at /docs and stack traces in error responses — local laptops only.
NODE_ENV=development

# HTTP port. 3001 keeps clear of the frontend dev server (3000).
PORT=3001

# pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Single allowed browser origin (cookies are sent with credentials, so no `*`).
CORS_ORIGIN=http://localhost:3000

# PostgreSQL as discrete parts (no DATABASE_URL; see src/config/database-url.ts).
# Defaults match docker/docker-compose.yml (`pnpm db:up`).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hacknation
DB_USER=hacknation
DB_PASSWORD=hacknation
# disable | allow | prefer | require | verify-ca | verify-full (default: require).
# The local container serves plaintext, so `disable` here.
DB_SSLMODE=disable

# HS256 key for the 15-minute access JWT, at least 32 characters. Production
# refuses to start with this example value: generate one, e.g. `openssl rand -base64 48`.
JWT_SECRET=dev-only-jwt-secret-change-me-in-production

# AES-256-GCM key (32 bytes, base64) for sensitive scan data encrypted at rest. Production
# refuses this example value: generate one with `openssl rand -base64 32`. Losing or
# changing it makes already stored encrypted fields unreadable.
DATA_ENCRYPTION_KEY=ZGV2LW9ubHktZGF0YS1rZXktY2hhbmdlLW1lLTAwMDA=

# Bearer token the scan workers send to /v1/workers/* (worker-manager: WORKER_MANAGER_TOKEN,
# set from WORKER_TOKEN by docker/docker-compose.workers.yml). At least 16 characters; unset
# turns the worker endpoints off (503). Production refuses this example value: generate one,
# e.g. `openssl rand -base64 32`.
WORKER_TOKEN=dev-only-worker-token-change-me

# Session cookies get the Secure flag: unset = in production only. Set false only for plain
# http opened by IP or hostname (browsers drop Secure cookies over http except on localhost).
COOKIE_SECURE=

# First admin account: created at startup while the database has no users yet,
# and by `pnpm db:seed` / `pnpm db:reset`. Production refuses this example password.
ADMIN_EMAIL=admin@hacknation.local
ADMIN_PASSWORD=admin-change-me-now

# Seed only (never in production): one demo account per remaining system role,
# editor@hacknation.local, analyst@hacknation.local and viewer@hacknation.local.
SEED_DEMO_USERS=true
DEMO_USER_PASSWORD=demo-password-2026

# Scan parameters snapshotted onto every scan queued by an import (src/modules/scans).
# TCP ports and ranges (e.g. 22,80,8000-8100); stay within the ports the lab allows.
SCAN_DEFAULT_PORTS=21,22,23,25,53,80,110,111,135,139,143,443,445,993,995,1433,1521,2049,3306,3389,5432,5900,6379,8000,8080,8443,9200,27017
# Packets per second a worker may send for one job.
SCAN_DEFAULT_MAX_RATE=100
# Addresses per scan job: a power of two from 16 to 1024 (256 = one /24).
SCAN_BATCH_SIZE=256
# The only TCP ports any scan may probe: pipeline steps outside them are refused. Set it to the
# lab's allowed ports; SCAN_DEFAULT_PORTS must stay inside it.
SCAN_ALLOWED_PORTS=1-65535
# A job whose lease expired this many times without a result is marked failed.
SCAN_JOB_MAX_ATTEMPTS=3

# Pipeline scheduler (src/modules/pipelines): fires scheduled pipelines, pauses scans whose time
# window closed, re-queues expired leases. Runs inside the API; several instances are safe.
PIPELINE_SCHEDULER_ENABLED=true
PIPELINE_SCHEDULER_TICK_SECONDS=15

# Leasing jobs to worker-manager (POST /v1/workers/manager/lease). A lease lasts until the job's
# deadline plus the grace (time to upload results; the manager sends no heartbeats), and a
# manager gets at most max_parallel x WORKER_LEASE_JOBS_PER_SLOT jobs per request.
WORKER_LEASE_GRACE_SECONDS=300
WORKER_LEASE_JOBS_PER_SLOT=2

# Vulnerability databases (src/modules/vulnerabilities), mirrored by `pnpm vulns:sync`.
# Sources to run, in order of preference: nvd, osv.
VULN_SOURCES=nvd,osv
# Incremental sync every N hours; a full sync (catches records removed from a source) every N days.
VULN_SYNC_INTERVAL_HOURS=8
VULN_FULL_SYNC_INTERVAL_DAYS=7
# How often the sync process checks for requests from the UI and for new scan results.
VULN_SYNC_POLL_SECONDS=30
# A full sync that would withdraw more than this share of a source's records stops instead.
VULN_SWEEP_MAX_RATIO=0.05
# Downloads, in the sources' own layout (relative to apps/backend); doubles as an offline mirror.
VULN_CACHE_DIR=.cache/vulnerabilities
# NVD JSON 2.0 data feeds. Offline: file:///path/to/mirror/nvd (see `pnpm vulns:mirror`).
NVD_FEED_URL=https://nvd.nist.gov/feeds/json/cve/2.0
NVD_FIRST_YEAR=2002
# OSV.dev bulk export. Offline: file:///path/to/mirror/osv.
OSV_BASE_URL=https://storage.googleapis.com/osv-vulnerabilities
OSV_ECOSYSTEMS=Maven,Go,Packagist,PyPI,Debian,Alpine,npm
# Record id prefixes left out: malicious-package reports, Debian advisories bundling several CVEs.
OSV_SKIP_PREFIXES=MAL-,DSA-,DLA-,DTSA-
# More changes than this since the last sync: read the ecosystem's whole zip instead.
OSV_INCREMENTAL_MAX_RECORDS=2000
