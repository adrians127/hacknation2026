{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "ESNext.Temporal"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode — tsdown builds, tsx runs in dev; tsc only type-checks. */
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,

    "paths": {
      "~backend/*": ["./src/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "prisma", "prisma.config.ts", "tsdown.config.ts", "vitest.config.ts"]
}
